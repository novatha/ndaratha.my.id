---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Novalio Daratha, Ph.D. - Associate Professor of Electrical Engineering" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav>
				<div class="logo">ND.</div>
				<div class="links">
					<a href="#about">About</a>
					<a href="#research">Research</a>
					<a href="#publications">Publications</a>
					<a href="#contact">Contact</a>
				</div>
			</nav>
		</header>
		<slot />
		<footer>
			<p>&copy; {new Date().getFullYear()} Novalio Daratha, Ph.D. All rights reserved.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--text: #111827; /* Near Black */
		--accent: #2563eb; /* Royal Blue */
		--muted: #4b5563; /* Slate 600 */
		--surface: #f9fafb; /* Very Light Gray */
		--border: #e5e7eb; /* Subtle Gray */
		
		--font-main: 'Inter', sans-serif;
		--font-serif: 'Playfair Display', serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		background-color: var(--bg);
	}

	body {
		font-family: var(--font-main);
		background-color: var(--bg);
		color: var(--text);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	header {
		position: fixed;
		top: 0;
		width: 100%;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(12px);
		z-index: 100;
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: 1100px;
		margin: 0 auto;
		padding: 1.25rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-weight: 900;
		color: var(--text);
	}

	.links {
		display: flex;
		gap: 2.5rem;
	}

	.links a {
		text-decoration: none;
		color: var(--muted);
		font-weight: 500;
		font-size: 0.9rem;
		transition: color 0.2s;
	}

	.links a:hover {
		color: var(--accent);
	}

	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 10rem 2rem 6rem;
	}

	section {
		margin-bottom: 10rem;
	}

	h1, h2, h3 {
		font-family: var(--font-serif);
		line-height: 1.2;
		color: #000000;
	}

	h2 {
		font-size: 2.75rem;
		margin-bottom: 3.5rem;
		position: relative;
		display: inline-block;
		font-weight: 900;
	}

	h2::after {
		content: '';
		position: absolute;
		bottom: -12px;
		left: 0;
		width: 40px;
		height: 3px;
		background: var(--accent);
	}

	p {
		font-size: 1.1rem;
		color: var(--muted);
	}

	.btn {
		display: inline-block;
		padding: 0.85rem 2.25rem;
		background: var(--text);
		color: white;
		text-decoration: none;
		border-radius: 4px;
		font-weight: 600;
		transition: all 0.2s ease;
	}

	.btn:hover {
		transform: translateY(-1px);
		background: var(--accent);
		box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
	}

	.btn.outline {
		background: transparent;
		border: 1px solid var(--border);
		color: var(--text);
	}

	.btn.outline:hover {
		background: var(--surface);
		border-color: var(--text);
	}

	footer {
		text-align: center;
		padding: 5rem 2rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.85rem;
		letter-spacing: 0.025em;
	}

	@media (max-width: 768px) {
		nav .links { display: none; }
		h2 { font-size: 2.25rem; }
	}
</style>