---
import { Image } from 'astro:assets';
import profileImg from '../../public/profile.jpg';
---
<section id="about" class="about-section">
	<h2 class="section-title">Academic Profile</h2>
	<div class="about-grid">
		<div class="about-text">
			<p>
				I am an Associate Professor in the Department of Electrical Engineering at the <strong>University of Bengkulu</strong>. 
				My work focuses on the intersection of electrical power systems and computational intelligence. 
				I hold a Ph.D. from <strong>IIT Roorkee</strong>, an M.Sc. from <strong>TU Delft</strong>, and an S.T. from <strong>Universitas Sriwijaya</strong>.
			</p>
			<p>
				My primary research objective is to enhance the resilience and stability of power grids. 
				I specialize in developing automated systems for contingency ranking, voltage security, 
				and the strategic integration of renewable energy sources.
			</p>
			<div class="expertise-list">
				<div class="expertise-item">
					<div class="icon">⚡</div>
					<div class="content">
						<h3>Power System Control</h3>
						<p>Stochastic security and voltage regulation.</p>
					</div>
				</div>
				<div class="expertise-item">
					<div class="icon">🤖</div>
					<div class="content">
						<h3>Intelligent Algorithms</h3>
						<p>Nature-inspired optimization (SSA, SCA, GA, PSO).</p>
					</div>
				</div>
				<div class="expertise-item">
					<div class="icon">🌱</div>
					<div class="content">
						<h3>Clean Integration</h3>
						<p>Wind and solar deployment strategies.</p>
					</div>
				</div>
			</div>
		</div>
		<div class="about-media">
			<div class="profile-frame">
				<Image src={profileImg} alt="Novalio Daratha, Ph.D." class="profile-image" width={600} height={760} format="webp" quality={85} />
			</div>
			<div class="education-timeline">
				<div class="timeline-item">
					<div class="year">2010-2016</div>
					<div class="inst">Ph.D. in Electrical Engineering — IIT Roorkee, India</div>
				</div>
				<div class="timeline-item">
					<div class="year">2005-2007</div>
					<div class="inst">M.Sc. in Electrical Engineering — TU Delft, Netherlands</div>
				</div>
				<div class="timeline-item">
					<div class="year">1998-2003</div>
					<div class="inst">S.T. in Electrical Engineering — Universitas Sriwijaya, Indralaya, South Sumatra</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 6rem;
		align-items: center;
	}

	.about-text p {
		margin-bottom: 2rem;
		font-size: 1.15rem;
		color: var(--muted);
	}

	.about-text strong {
		color: var(--text);
	}

	.expertise-list {
		margin-top: 4rem;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.expertise-item {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}

	.expertise-item .icon {
		font-size: 1.5rem;
		background: var(--surface);
		width: 55px;
		height: 55px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 4px;
		border: 1px solid var(--border);
	}

	.expertise-item h3 {
		font-size: 1.15rem;
		margin-bottom: 0.15rem;
		color: var(--text);
		font-family: var(--font-main);
		font-weight: 700;
	}

	.expertise-item p {
		font-size: 0.95rem;
		color: var(--muted);
		margin-bottom: 0;
	}

	.about-media {
		display: flex;
		flex-direction: column;
		gap: 4rem;
		align-items: center;
	}

	.profile-frame {
		width: 300px;
		height: 380px;
		background: var(--surface);
		border: 1px solid var(--border);
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
	}

	.profile-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.profile-initials {
		font-family: var(--font-serif);
		font-size: 6rem;
		font-weight: 900;
		color: var(--accent);
		opacity: 0.1;
	}

	.education-timeline {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.timeline-item {
		display: flex;
		gap: 2rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.timeline-item .year {
		font-weight: 700;
		color: var(--text);
		font-size: 0.9rem;
		min-width: 60px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.timeline-item .inst {
		color: var(--muted);
		font-size: 1rem;
	}

	@media (max-width: 900px) {
		.about-grid { grid-template-columns: 1fr; gap: 4rem; }
		.about-media { order: -1; }
	}
</style>