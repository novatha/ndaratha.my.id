{
  "version": 1,
  "author": "Laboratorium Jaringan Komputer & Sistem Tertanam FT UNIB",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -80, "left": -120, "attrs": { "value": "2048" } },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": 160, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 90, "left": 160, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:SIG", "esp:34", "blue", [ "v0" ] ],
    [ "esp:2", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:K", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
