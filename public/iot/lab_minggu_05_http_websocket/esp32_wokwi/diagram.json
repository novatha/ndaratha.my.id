    [ "dht1:SDA", "esp:D4", "green", [] ],
    [ "potWater:VCC", "esp:3V3", "red", [] ],
    [ "potWater:GND", "esp:GND.1", "black", [] ],
    [ "potWater:SIG", "esp:D34", "blue", [] ],
    [ "esp:D26", "rPump:1", "orange", [] ],
    [ "rPump:2", "ledPump:A", "orange", [] ],
    [ "ledPump:C", "esp:GND.2", "black", [] ],
    [ "btnOverride:1.l", "esp:D15", "purple", [] ],
    [ "btnOverride:2.l", "esp:GND.2", "black", [] ]
